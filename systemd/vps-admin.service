[Unit]
Description=VPS Admin Telegram bot
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/vps-admin
EnvironmentFile=/opt/vps-admin/.env
Environment=PYTHONPATH=/opt/vps-admin/backend
ExecStart=/opt/vps-admin/.venv/bin/python -m vps_admin.telegram_bot
Restart=always
RestartSec=5
User=vpsadmin
Group=vpsadmin
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/vps-admin/data

[Install]
WantedBy=multi-user.target
